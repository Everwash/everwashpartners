<script>
// Add form submission tracking without breaking Netlify functionality
document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('everWashForm');

    if (form) {
        form.addEventListener('submit', function(e) {
            // Don't prevent default - let Netlify handle the form submission

            // Track with Google Analytics
            if (typeof gtag === 'function') {
                gtag('event', 'conversion_event_submit_lead_form', {
                    'event_category': 'Contact Form',
                    'event_label': 'Contact Page Submission'
                });
                console.log('Google Analytics form submission tracked');
            }
            
            // Track with Hotjar (if available)
            if (typeof hj === 'function') {
                hj('event', 'contact_form_submit');
                console.log('Hotjar form submission tracked');
            }


        });
    }
});
</script>


<script>
function initEverWashAutocomplete() {
  const searchInput = document.getElementById('carWashSearch');
  const manualFields = document.getElementById('manualAddressFields');
  const manualTriggerBtn = document.getElementById('manualTriggerBtn');
  const manualTriggerWrapper = document.getElementById('manualTriggerWrapper');
  
  if (!searchInput) return;

  // ১. স্টেট ম্যাপিং অবজেক্ট (Abbreviation to Full Name)
  const stateNames = {
    'AL': 'Alabama', 'AK': 'Alaska', 'AZ': 'Arizona', 'AR': 'Arkansas', 'CA': 'California',
    'CO': 'Colorado', 'CT': 'Connecticut', 'DE': 'Delaware', 'FL': 'Florida', 'GA': 'Georgia',
    'HI': 'Hawaii', 'ID': 'Idaho', 'IL': 'Illinois', 'IN': 'Indiana', 'IA': 'Iowa',
    'KS': 'Kansas', 'KY': 'Kentucky', 'LA': 'Louisiana', 'ME': 'Maine', 'MD': 'Maryland',
    'MA': 'Massachusetts', 'MI': 'Michigan', 'MN': 'Minnesota', 'MS': 'Mississippi', 'MO': 'Missouri',
    'MT': 'Montana', 'NE': 'Nebraska', 'NV': 'Nevada', 'NH': 'New Hampshire', 'NJ': 'New Jersey',
    'NM': 'New Mexico', 'NY': 'New York', 'NC': 'North Carolina', 'ND': 'North Dakota', 'OH': 'Ohio',
    'OK': 'Oklahoma', 'OR': 'Oregon', 'PA': 'Pennsylvania', 'RI': 'Rhode Island', 'SC': 'South Carolina',
    'SD': 'South Dakota', 'TN': 'Tennessee', 'TX': 'Texas', 'UT': 'Utah', 'VT': 'Vermont',
    'VA': 'Virginia', 'WA': 'Washington', 'WV': 'West Virginia', 'WI': 'Wisconsin', 'WY': 'Wyoming'
  };

  const autocomplete = new google.maps.places.Autocomplete(searchInput, {
    types: ['establishment'],
    componentRestrictions: { country: 'us' },
    fields: ['address_components', 'name']
  });

  // ২. ম্যানুয়াল লিঙ্ক-এ ক্লিক করলে ফিল্ড ওপেন হবে
  if (manualTriggerBtn) {
    manualTriggerBtn.addEventListener('click', function() {
      showManualFields();
    });
  }

  // ৩. গুগল সাজেশান থেকে সিলেক্ট করলে যা হবে
  autocomplete.addListener('place_changed', function () {
    const place = autocomplete.getPlace();
    if (place.address_components) {
      // সাজেশান পেলে ম্যানুয়াল লিঙ্ক হাইড করে দেব
      if (manualTriggerWrapper) manualTriggerWrapper.style.display = 'none';
      manualFields.style.display = 'none'; 
      
      fillAddressData(place.address_components);
      searchInput.value = place.name;
    }
  });

  function fillAddressData(components) {
    let streetNumber = "";
    let route = "";
    
    components.forEach(c => {
      const type = c.types[0];
      
      if (type === "street_number") streetNumber = c.long_name;
      if (type === "route") route = c.long_name;
      if (type === "locality") document.getElementById('locality').value = c.long_name;
      
      // স্টেট কনভার্সন লজিক
      if (type === "administrative_area_level_1") {
        const abbr = c.short_name.toUpperCase();
        // FL থাকলে Florida বসাবে, না থাকলে গুগলের ডিফল্ট long_name বসাবে
        document.getElementById('administrative_area_level_1').value = stateNames[abbr] || c.long_name;
      }
      
      if (type === "postal_code") document.getElementById('postal_code').value = c.long_name;
    });
    
    document.getElementById('street_address').value = `${streetNumber} ${route}`.trim();
  }

  function showManualFields() {
    manualFields.style.display = 'flex';
    if (manualTriggerWrapper) manualTriggerWrapper.style.display = 'none';
    
    // ম্যানুয়াল ইনপুটগুলোকে required করে দেওয়া
    document.querySelectorAll('#manualAddressFields input').forEach(input => {
      input.required = true;
    });
  }

  searchInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') e.preventDefault();
  });
}

window.onload = initEverWashAutocomplete;
</script>

<script>
document.addEventListener("DOMContentLoaded", function() {
    const v1 = document.getElementById('form-v1-container');
    const v2 = document.getElementById('form-v2-container');
    
    // চেক করা হচ্ছে ইউজারের জন্য আগে থেকেই কোনো ভার্সন অ্যাসাইন করা আছে কি না
    let assignedForm = localStorage.getItem('everwash_ab_test');

    if (!assignedForm) {
        // ৫০/৫০ চান্সে র‍্যান্ডমলি একটি ফর্ম সিলেক্ট করা হচ্ছে
        assignedForm = Math.random() < 0.5 ? 'v1' : 'v2';
        localStorage.setItem('everwash_ab_test', assignedForm);
    }

    // সিলেক্টেড ফর্মটি দেখানো হচ্ছে
    if (assignedForm === 'v1') {
        v1.style.display = 'block';
        console.log("A/B Test: Form 1 (CRO Form) is visible");
    } else {
        v2.style.display = 'block';
        console.log("A/B Test: Form 2 (EverWash Form) is visible");
    }
});
</script>
