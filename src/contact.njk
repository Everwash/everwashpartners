layout: base.njk
title: Contact Sales - EverWash
---

<!-- Hero Section -->
<section class="contact-hero">
  <div class="container">
    <div class="row justify-content-center text-center">
      <div class="col-lg-8">
        <h1 class="hero-title">Ready to <span style="color: #f3f183;">Grow?</span></h1>
        <p class="hero-text">Connect with our sales team to learn how EverWash can transform your car wash business.</p>
      </div>
    </div>
  </div>
  <div class="curve">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 80" preserveAspectRatio="none">
      <path fill="#f8f8ff" d="M0,0 C720,40 720,40 1440,0 L1440,80 L0,80 Z"></path>
    </svg>
  </div>
</section>

<section class="contact-section">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-10">
        <div class="contact-card">
          <div class="row g-0">
            <div class="col-md-5 contact-info-sidebar">
              <h1 class="sidebar-title">GET IN TOUCH<br>WITH SALES</h1>
              <p>Fill out the form or contact us directly and our team will get back to you within 24 hours.</p>

              <div class="info-item">
                <i class="fas fa-envelope"></i>
                <span><a href="mailto:sales@everwash.com" class="text-white">sales@everwash.com</a></span>
              </div>
              <div class="info-item">
                <i class="fas fa-phone-alt"></i>
                <span><a href="tel:+18554927477" class="text-white">(855) 492-7477</a></span>
              </div>
            </div>

            <div class="col-md-7">
              <div class="contact-form">
                <div class="text-center mb-4">
                  <img src="/assets/images/everwash-logo-horizontal.png" alt="EverWash" class="form-logo mb-3">
                  <p class="form-subtext">Talk to a membership professional about how the EverWash platform can increase
                    the overall profitability of your wash</p>
                </div>
                <div id="form-v1-container">
                  <p id="contact-progress" class="small text-muted" aria-live="polite" hidden>Step 1 of 2</p>
                  <form 
                  id="everWashForm" 
                  name="EverWash Form" 
                  method="POST"
                  action="/thank-you/" 
                  data-netlify="true" 
                  data-netlify-honeypot="bot-field"
                  aria-describedby="contact-progress"
                  netlify
                >
                    <fieldset id="contact-step-1">
                      <legend class="visually-hidden">Contact details</legend>
                      <div class="row g-3">
                      <div class="col-md-6">
                        <label class="form-label" for="contact-firstName">First Name</label>
                        <input type="text" class="form-control" id="contact-firstName" name="firstName" autocomplete="given-name" required>
                      </div>
                      <div class="col-md-6">
                        <label class="form-label" for="contact-lastName">Last Name</label>
                        <input type="text" class="form-control" id="contact-lastName" name="lastName" autocomplete="family-name" required>
                      </div>
                      <div class="col-md-12">
                        <label class="form-label" for="contact-phone">Phone Number</label>
                        <input type="tel" class="form-control" id="contact-phone" name="phone" autocomplete="tel" required>
                      </div>
                      <div class="col-md-12">
                        <label class="form-label" for="contact-email">Email Address</label>
                        <input type="email" class="form-control" id="contact-email" name="email" autocomplete="email" required>
                      </div>
                        <div class="col-12 mt-4" id="contact-next-container" hidden>
                          <button type="button" id="contact-next" class="btn btn-primary btn-lg w-100">Next</button>
                        </div>
                      </div>
                    </fieldset>
                    <fieldset id="contact-step-2">
                      <legend class="visually-hidden">Car wash details</legend>
                      <div class="row g-3">
                      <div class="col-md-12">
                        <label class="form-label" for="contact-carWashName">Car Wash Name</label>
                        <input type="text" class="form-control" id="contact-carWashName" name="carWashName" autocomplete="organization" required>
                      </div>
                      <div class="col-md-12">
                        <label class="form-label" for="contact-washType">Wash Type</label>
                        <select class="form-select" id="contact-washType" name="washType" required>
                          <option value="" selected disabled>Choose Wash Type</option>
                          <option value="tunnel">Tunnel</option>
                          <option value="iba">IBA</option>
                          <option value="self-serve">Self Serve</option>
                          <option value="other">Other</option>
                        </select>
                      </div>
                      <div class="col-md-8">
                        <label class="form-label" for="contact-state">State</label>
                        <select class="form-select" id="contact-state" name="state" autocomplete="address-level1" required>
                          <option value="" selected disabled>Choose State</option>
                          <option value="Alabama">Alabama</option>
                          <option value="Alaska">Alaska</option>
                          <option value="Arizona">Arizona</option>
                          <option value="Arkansas">Arkansas</option>
                          <option value="California">California</option>
                          <option value="Colorado">Colorado</option>
                          <option value="Connecticut">Connecticut</option>
                          <option value="Delaware">Delaware</option>
                          <option value="Florida">Florida</option>
                          <option value="Georgia">Georgia</option>
                          <option value="Hawaii">Hawaii</option>
                          <option value="Idaho">Idaho</option>
                          <option value="Illinois">Illinois</option>
                          <option value="Indiana">Indiana</option>
                          <option value="Iowa">Iowa</option>
                          <option value="Kansas">Kansas</option>
                          <option value="Kentucky">Kentucky</option>
                          <option value="Louisiana">Louisiana</option>
                          <option value="Maine">Maine</option>
                          <option value="Maryland">Maryland</option>
                          <option value="Massachusetts">Massachusetts</option>
                          <option value="Michigan">Michigan</option>
                          <option value="Minnesota">Minnesota</option>
                          <option value="Mississippi">Mississippi</option>
                          <option value="Missouri">Missouri</option>
                          <option value="Montana">Montana</option>
                          <option value="Nebraska">Nebraska</option>
                          <option value="Nevada">Nevada</option>
                          <option value="New Hampshire">New Hampshire</option>
                          <option value="New Jersey">New Jersey</option>
                          <option value="New Mexico">New Mexico</option>
                          <option value="New York">New York</option>
                          <option value="North Carolina">North Carolina</option>
                          <option value="North Dakota">North Dakota</option>
                          <option value="Ohio">Ohio</option>
                          <option value="Oklahoma">Oklahoma</option>
                          <option value="Oregon">Oregon</option>
                          <option value="Pennsylvania">Pennsylvania</option>
                          <option value="Rhode Island">Rhode Island</option>
                          <option value="South Carolina">South Carolina</option>
                          <option value="South Dakota">South Dakota</option>
                          <option value="Tennessee">Tennessee</option>
                          <option value="Texas">Texas</option>
                          <option value="Utah">Utah</option>
                          <option value="Vermont">Vermont</option>
                          <option value="Virginia">Virginia</option>
                          <option value="Washington">Washington</option>
                          <option value="West Virginia">West Virginia</option>
                          <option value="Wisconsin">Wisconsin</option>
                          <option value="Wyoming">Wyoming</option>
                        </select>
                      </div>
                      <div class="col-md-4">
                        <label class="form-label" for="contact-zipCode">Zip Code</label>
                        <input type="text" class="form-control" id="contact-zipCode" name="zipCode" autocomplete="postal-code" required>
                      </div>
                        <div class="col-12 mt-4 d-flex gap-3">
                          <button type="button" id="contact-back" hidden class="btn btn-outline-secondary btn-lg">Back</button>
                          <button type="submit" class="btn btn-primary btn-lg flex-grow-1">Submit</button>
                        </div>
                      </div>
                    </fieldset>
                </form>
                      <p class="mt-4 text-muted" style="font-size: 14px; line-height: 1.5;">* This form is specifically
                        for Car Wash Owners who wish to contact EverWash about setting up a membership program at their
                        location. If you are a current EverWash member looking for customer support, please contact our
                        Member Support Team at <a href="mailto:support@everwash.com">support@everwash.com</a> or call <a
                          href="tel:+12156188808">215-618-8808</a> to speak with an agent.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
</section>

<style>
  .contact-hero {
    position: relative;
    background:  url('/assets/images/contact-hero-bg.png');
    background-size: cover;
    background-position: center;
    color: var(--color-white);
    padding: 12rem 0 6rem;
    text-align: center;
  }

  .contact-hero .hero-title {
