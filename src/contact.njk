<style>

.contact-form {
    padding: 16px 20px;
    text-align: left;
  }

  .contact-card {
    background: white;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
  }

  .form-label {
    font-size: 16px;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 0;
  }

  .form-control,
  .form-select {
    padding: 8px 8px;
    border-radius: 8px;
    border: 1px solid #ddd;
  }

  .form-control:focus,
  .form-select:focus {
    border-color: var(--color-secondary);
    box-shadow: 0 0 0 0.2rem rgba(253, 196, 45, 0.25);
  }

  .form-subtext {
    font-size: 16px;
    color: var(--color-primary);
    max-width: 450px;
    margin: 0 auto;
  }

  @media screen and (max-width: 667px) {
    .contact-form.contact-card {
      margin-top: 50px;
    }

    .hero-text {
      margin-right: 0;
      margin-top: 0;
    }

  }
</style>


<script>
// Add form submission tracking without breaking Netlify functionality
document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('everWashForm');

    if (form) {
        const stepOne = document.getElementById('contact-step-1');
        const stepTwo = document.getElementById('contact-step-2');
        const progress = document.getElementById('contact-progress');
        const next = document.getElementById('contact-next');

        function showStepTwo(visible) {
            stepOne.hidden = stepOne.disabled = visible;
            stepTwo.hidden = stepTwo.disabled = !visible;
            progress.textContent = visible ? 'Step 2 of 2' : 'Step 1 of 2';
            (visible ? stepTwo : stepOne).querySelector('input').focus();
        }

        next.addEventListener('click', function() {
            if (form.reportValidity()) showStepTwo(true);
        });

        document.getElementById('contact-back').addEventListener('click', function() {
            showStepTwo(false);
        });

        stepOne.addEventListener('keydown', function(event) {
            if (event.key === 'Enter' && event.target.matches('input') && !event.isComposing) {
                event.preventDefault();
                next.click();
            }
        });

        form.noValidate = true;
        stepTwo.hidden = stepTwo.disabled = true;
        progress.hidden = false;
        document.getElementById('contact-next-container').hidden = false;
        document.getElementById('contact-back').hidden = false;

        form.addEventListener('submit', function(e) {
            if (!form.reportValidity()) {
                e.preventDefault();
                return;
            }
            if (!stepOne.hidden) {
                e.preventDefault();
                showStepTwo(true);
                return;
            }

            stepOne.disabled = false;
            if (!Array.from(stepOne.querySelectorAll('input')).every(input => input.checkValidity())) {
                e.preventDefault();
                showStepTwo(false);
                form.reportValidity();
                return;
            }

            // Track with Google Analytics
            if (typeof gtag === 'function') {
                gtag('event', 'conversion_event_submit_lead_form', {
                    'event_category': 'Contact Form',
                    'event_label': 'Contact Page Submission'
                });
                console.log('Google Analytics form submission tracked');
            }
            
            // Track with Hotjar (if available)
            if (typeof hj === 'function') {
                hj('event', 'contact_form_submit');
                console.log('Hotjar form submission tracked');
            }


        });
    }
});
</script>


